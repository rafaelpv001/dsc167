# Rifa Online - variáveis de ambiente (backend)
# Copie para backend/.env e preencha com valores locais/reais.
# NUNCA versionar o arquivo .env com valores reais.

NODE_ENV=development
PORT=3001

# Postgres (deve bater com o docker-compose.yml)
DATABASE_URL=postgresql://rifa:rifa@localhost:5432/rifa?schema=public

# URL pública da aplicação (usada em links de pagamento, webhooks, etc.)
APP_URL=http://localhost:3000

# Segredos de sessão/autenticação (gerar valores fortes e únicos por ambiente)
SESSION_SECRET=
JWT_SECRET=

# Administrador inicial (seed)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PagBank (PIX)
PAGBANK_ENVIRONMENT=sandbox
PAGBANK_TOKEN=
PAGBANK_API_URL=
PAGBANK_WEBHOOK_URL=

# Ambiente de demonstração/teste (NUNCA habilitar em produção real):
# - login fixo teste/teste (ver DEMO_ADMIN_EMAIL/DEMO_ADMIN_PASSWORD)
# - seed cria "Rifa Solidária de Teste" (400 números, ACTIVE)
# - toda reserva é confirmada automaticamente (simula pagamento aprovado), sem chamar o PagBank real
# - pedidos/pagamentos com mais de DEMO_RETENTION_MINUTES são apagados definitivamente (sem histórico)
DEMO_MODE=false
DEMO_ADMIN_EMAIL=teste
DEMO_ADMIN_PASSWORD=teste
DEMO_RAFFLE_SLUG=rifa-solidaria-de-teste
DEMO_AUTOCONFIRM_DELAY_MS=4000
DEMO_RETENTION_MINUTES=60

# Deploy serverless (Vercel) — ver README "Deploy no Vercel". Não usados em
# desenvolvimento local/Docker.
# Segredo que protege /api/internal/cron/* (Vercel injeta automaticamente como
# "Authorization: Bearer <CRON_SECRET>" quando esta env var está definida no projeto).
CRON_SECRET=
# Token do Vercel Blob Storage — quando definido, upload de imagens usa Blob
# em vez de disco local (obrigatório em produção serverless).
BLOB_READ_WRITE_TOKEN=
